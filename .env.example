# Use Supabase Project Settings > Database > Session pooler (port 5432 or 6543).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SHOW_DEMO_CREDENTIALS=false

# Used only by npm run db:create-admin. Do not add these to Vercel.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Fleet Administrator
ADMIN_PASSWORD=ChangeThisPassword123